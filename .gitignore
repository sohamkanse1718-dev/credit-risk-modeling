# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# =========================
# Virtual environments
# =========================
venv/
.venv/
env/
ENV/

# =========================
# Secrets / local config
# =========================
.env
.envrc

# =========================
# Testing / tooling caches
# =========================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.mypy_cache/
.ruff_cache/

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# Logs (e.g. API prediction logs)
# =========================
*.log
logs/

# =========================
# Data (large and regenerable)
# Ignore contents, keep the folders via .gitkeep
# =========================
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Keep small test fixtures tracked
!tests/fixtures/
!tests/fixtures/*.csv


# =========================
# OS / editor
# =========================
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
tempCodeRunnerFile.py