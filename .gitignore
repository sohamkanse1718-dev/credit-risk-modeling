*.py[cod]
*$py.class
*.so
*.dylib
*.dll
*.egg-info/
*.egg
build/
dist/
.eggs/
develop-eggs/
downloads/
parts/
var/

# =========================
# Virtual Environments
# =========================
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
conda/
.conda/

# =========================
# Secrets, Passwords & Credentials (CRITICAL)
# =========================
.env
.env.*
*.env
.envrc
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
id_rsa*
id_ed25519*
secrets.json
credentials.json
service-account*.json
*service_account*.json
client_secrets*.json
*.token

# =========================
# Testing & Tooling Caches
# =========================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
coverage.xml
nosetests.xml

# =========================
# Jupyter Notebooks
# =========================
.ipynb_checkpoints/
*-checkpoint.ipynb

# =========================
# Logs & Monitoring
# =========================
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt

# =========================
# Data (Large & Regenerable Datasets)
# =========================
# Ignore data subfolders but keep directory structure via .gitkeep
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Catch loose data files placed in data/
data/*.csv
data/*.parquet
data/*.feather

# Compressed archives often containing massive raw datasets
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.bz2

# Keep test fixtures tracked
!tests/fixtures/
!tests/fixtures/*

# =========================
# Model Artifacts & Checkpoints
# =========================
# Note: Production model (models/model.pkl, models/model_metadata.json) remains tracked.
# Ignore temporary checkpoints, extra serialized models, and heavy dumps.
models/*.joblib
models/*.onnx
models/*.pt
models/*.bin
models/checkpoints/

# =========================
# MLflow Tracking & Artifacts
# =========================
mlflow.db
mlflow.db-journal
mlflow.db-wal
mlflow.db-shm
*.db-journal
*.db-wal
*.db-shm
mlruns/
mlartifacts/
.trash/

# =========================
# Operating System & Editors
# =========================
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~
tempCodeRunnerFile.py
*.code-workspace
